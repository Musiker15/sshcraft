# Environment of the SSHCraft sync server (docs/server.md, "Settings").
# Keep this file readable only by the service user: the database URL can hold a password.

# The address clients type in. Every login is signed for it.
SSHCRAFT_PUBLIC_ORIGIN=https://sync.example.org

# Behind a reverse proxy on the same host, loopback is enough.
SSHCRAFT_LISTEN=127.0.0.1:8470

# SQLite in the service's folder, or PostgreSQL on the same host:
#   SSHCRAFT_DATABASE_URL=postgres://sshcraft:<password>@127.0.0.1/sshcraft
SSHCRAFT_DATABASE_URL=sqlite:///var/lib/sshcraft/sshcraft.db

RUST_LOG=info
