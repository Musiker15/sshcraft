<?xml version="1.0" encoding="utf-8"?>
<!-- Adapted from storytold/gridcraft (Apache-2.0). -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <?ifndef HasCraftFontLicences ?>
  <?define HasCraftFontLicences=0 ?>
  <?endif?>
  <Package Name="SSHCraft" Manufacturer="MSK Scripts" Version="$(var.Version)" UpgradeCode="E577A976-EE1A-4C98-96B7-D3A2EBE306CB" Scope="perUserOrMachine" Compressed="yes" Language="1033">
    <SummaryInformation Description="SSHCraft SSH client" Manufacturer="MSK Scripts" />
    <?include $(sys.SOURCEFILEDIR)install-policy.wxi?>
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer version of SSHCraft is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- The Tauri version of SSHCraft (an NSIS installer, uninstall entry "SSHCraft") must not
         run beside this one: both would sync with the same device key. It is not removed from
         here, which would run its uninstaller unseen; the install stops and says how. Its
         uninstaller keeps the data unless "Delete the application data" is ticked. -->
    <Property Id="TAURI_SSHCRAFT_U">
      <RegistrySearch Id="TauriUninstallUser" Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\SSHCraft" Name="UninstallString" Type="raw" />
    </Property>
    <Property Id="TAURI_SSHCRAFT_M">
      <RegistrySearch Id="TauriUninstallMachine" Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\SSHCraft" Name="UninstallString" Type="raw" />
    </Property>
    <Launch Condition="Installed OR (NOT TAURI_SSHCRAFT_U AND NOT TAURI_SSHCRAFT_M)" Message="The previous SSHCraft (from before version 1) is still installed. Uninstall it first in Settings, Apps. Leave Delete the application data unticked and your hosts, keys and settings stay. Then run this installer again." />

    <Icon Id="SshcraftIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="SshcraftIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/musiker15/sshcraft" />
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/musiker15/sshcraft/releases" />
    <Property Id="ARPHELPLINK" Value="https://github.com/musiker15/sshcraft/issues" />

    <!-- An explicit command-line value wins. Otherwise retain the previous installation's
         choice, defaulting to off for a fresh install. Run only in the first sequence so the
         execute sequence cannot reload the old choice after the user unchecks the box. -->
    <Property Id="DESKTOPSHORTCUT" Secure="yes" />
    <Property Id="SAVEDDESKTOPSHORTCUT" Secure="yes">
      </Property>
    <SetProperty Id="DESKTOPSHORTCUT" Action="LoadDesktopShortcutPreference" Value="1" After="CraftLoadOption1U" Sequence="first" Condition="NOT DESKTOPSHORTCUT AND SAVEDDESKTOPSHORTCUT = &quot;1&quot;" />
    <SetProperty Id="DESKTOPSHORTCUT" Action="DefaultDesktopShortcut" Value="0" After="LoadDesktopShortcutPreference" Sequence="first" Condition="NOT DESKTOPSHORTCUT" />
    <SetProperty Id="DesktopShortcutChoice" Value="1" After="DefaultDesktopShortcut" Sequence="ui" Condition="DESKTOPSHORTCUT = &quot;1&quot;" />

    <Property Id="DefaultUIFont" Value="SshcraftUIFont" />
    <Property Id="ErrorDialog" Value="SshcraftErrorDlg" />
    <EnsureTable Id="ListBox" />
    <UI>
      <TextStyle Id="SshcraftUIFont" FaceName="Segoe UI" Size="9" />
      <Dialog Id="DesktopShortcutDlg" Width="320" Height="150" Title="SSHCraft Setup" NoMinimize="yes">
        <Control Id="Heading" Type="Text" X="15" Y="15" Width="290" Height="20" Text="Install SSHCraft" />
        <Control Id="Description" Type="Text" X="15" Y="40" Width="290" Height="28" Text="Install SSHCraft using the account option you selected." />
        <Control Id="DesktopShortcutCheckbox" Type="CheckBox" X="15" Y="76" Width="290" Height="18" Property="DesktopShortcutChoice" CheckBoxValue="1" Text="Create a &amp;desktop shortcut" />
        <Control Id="Install" Type="PushButton" X="165" Y="118" Width="65" Height="20" Default="yes" DefaultCondition="ALLUSERS = 1" ElevationShield="yes" HideCondition="ALLUSERS &lt;&gt; 1" ShowCondition="ALLUSERS = 1" Text="&amp;Install">
          <!-- An unchecked checkbox clears its property. Publish an explicit zero so the
               elevated execute sequence receives an unambiguous opt-out. -->
          <Publish Property="DESKTOPSHORTCUT" Value="1" Condition="DesktopShortcutChoice" />
          <Publish Property="DESKTOPSHORTCUT" Value="0" Condition="NOT DesktopShortcutChoice" />
          <Publish Event="EndDialog" Value="Return" />
        </Control>
        <Control Id="InstallUser" Type="PushButton" DefaultCondition="ALLUSERS &lt;&gt; 1" HideCondition="ALLUSERS = 1" ShowCondition="ALLUSERS &lt;&gt; 1" X="165" Y="118" Width="65" Height="20" Text="&amp;Install">
          <!-- An unchecked checkbox clears its property. Publish an explicit zero so the
               elevated execute sequence receives an unambiguous opt-out. -->
          <Publish Property="DESKTOPSHORTCUT" Value="1" Condition="DesktopShortcutChoice" />
          <Publish Property="DESKTOPSHORTCUT" Value="0" Condition="NOT DesktopShortcutChoice" />
          <Publish Event="EndDialog" Value="Return" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="240" Y="118" Width="65" Height="20" Cancel="yes" Text="Cancel">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
      </Dialog>

      <!-- Windows Installer requires these support dialogs for authored full UI (ICE20).
           They contain only installer messages and standard response controls. -->
      <Dialog Id="SshcraftErrorDlg" Width="320" Height="120" Title="SSHCraft Setup" ErrorDialog="yes" NoMinimize="yes">
        <Control Id="ErrorText" Type="Text" X="15" Y="15" Width="290" Height="65" TabSkip="no" />
        <Control Id="A" Type="PushButton" X="15" Y="90" Width="65" Height="20" Text="Abort" TabSkip="yes">
          <Publish Event="EndDialog" Value="ErrorAbort" />
        </Control>
        <Control Id="C" Type="PushButton" X="15" Y="90" Width="65" Height="20" Text="Cancel" TabSkip="yes">
          <Publish Event="EndDialog" Value="ErrorCancel" />
        </Control>
        <Control Id="I" Type="PushButton" X="15" Y="90" Width="65" Height="20" Text="Ignore" TabSkip="yes">
          <Publish Event="EndDialog" Value="ErrorIgnore" />
        </Control>
        <Control Id="N" Type="PushButton" X="15" Y="90" Width="65" Height="20" Text="No" TabSkip="yes">
          <Publish Event="EndDialog" Value="ErrorNo" />
        </Control>
        <Control Id="O" Type="PushButton" X="15" Y="90" Width="65" Height="20" Text="OK" TabSkip="yes">
          <Publish Event="EndDialog" Value="ErrorOk" />
        </Control>
        <Control Id="R" Type="PushButton" X="15" Y="90" Width="65" Height="20" Text="Retry" TabSkip="yes">
          <Publish Event="EndDialog" Value="ErrorRetry" />
        </Control>
        <Control Id="Y" Type="PushButton" X="15" Y="90" Width="65" Height="20" Text="Yes" TabSkip="yes">
          <Publish Event="EndDialog" Value="ErrorYes" />
        </Control>
      </Dialog>
      <Dialog Id="FilesInUse" Width="320" Height="190" Title="SSHCraft Setup" NoMinimize="yes">
        <Control Id="Description" Type="Text" X="15" Y="15" Width="290" Height="35" Text="Close the applications listed below, then choose Retry. Ignore may require a restart." />
        <Control Id="Files" Type="ListBox" X="15" Y="55" Width="290" Height="85" Property="FileInUseProcess" />
        <Control Id="Retry" Type="PushButton" X="95" Y="155" Width="65" Height="20" Default="yes" Text="Retry">
          <Publish Event="EndDialog" Value="Retry" />
        </Control>
        <Control Id="Ignore" Type="PushButton" X="167" Y="155" Width="65" Height="20" Text="Ignore">
          <Publish Event="EndDialog" Value="Ignore" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="240" Y="155" Width="65" Height="20" Cancel="yes" Text="Cancel">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
      </Dialog>
      <Dialog Id="SetupCompleteDlg" Width="320" Height="110" Title="SSHCraft Setup" NoMinimize="yes">
        <Control Id="Message" Type="Text" X="15" Y="20" Width="290" Height="35" Text="SSHCraft setup completed." />
        <Control Id="Close" Type="PushButton" X="240" Y="75" Width="65" Height="20" Default="yes" Cancel="yes" Text="Close">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
      </Dialog>
      <Dialog Id="SetupCanceledDlg" Width="320" Height="110" Title="SSHCraft Setup" NoMinimize="yes">
        <Control Id="Message" Type="Text" X="15" Y="20" Width="290" Height="35" Text="SSHCraft setup was canceled." />
        <Control Id="Close" Type="PushButton" X="240" Y="75" Width="65" Height="20" Default="yes" Cancel="yes" Text="Close">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
      </Dialog>
      <Dialog Id="SetupFailedDlg" Width="320" Height="110" Title="SSHCraft Setup" NoMinimize="yes">
        <Control Id="Message" Type="Text" X="15" Y="20" Width="290" Height="35" Text="SSHCraft setup could not finish. See the installer message or log for details." />
        <Control Id="Close" Type="PushButton" X="240" Y="75" Width="65" Height="20" Default="yes" Cancel="yes" Text="Close">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
      </Dialog>
    </UI>
    <InstallUISequence>
      <!-- Component conditions must see the choice before costing. Do not show the choice
           during basic/silent installs, repair or uninstall. -->
      <Show Dialog="DesktopShortcutDlg" Before="CostInitialize" Condition="NOT Installed AND NOT REMOVE AND UILevel = 5" />
      <Show Dialog="SetupCompleteDlg" OnExit="success" Condition="UILevel = 5" />
      <Show Dialog="SetupCanceledDlg" OnExit="cancel" Condition="UILevel = 5" />
      <Show Dialog="SetupFailedDlg" OnExit="error" Condition="UILevel = 5" />
    </InstallUISequence>
    <AdminUISequence>
      <Show Dialog="SetupCompleteDlg" OnExit="success" Condition="UILevel = 5" />
      <Show Dialog="SetupCanceledDlg" OnExit="cancel" Condition="UILevel = 5" />
      <Show Dialog="SetupFailedDlg" OnExit="error" Condition="UILevel = 5" />
    </AdminUISequence>

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="SSHCraft" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />
    <StandardDirectory Id="DesktopFolder" />

    <Feature Id="Main" Title="SSHCraft" Level="1">
      <?if $(var.HasCraftFontLicences) = 1 ?>
      <ComponentGroupRef Id="CraftFontLicences" />
      <?endif?>
      <ComponentGroupRef Id="SshcraftFiles" />
    </Feature>
  <Property Id="CRAFT_OPTION_1_M" Secure="yes"><RegistrySearch Id="CRAFT_OPTION_1_MSearch" Root="HKLM" Key="Software\SSHCraft\Installer" Name="DesktopShortcut" Type="raw" />
    </Property><SetProperty Id="SAVEDDESKTOPSHORTCUT" Action="CraftLoadOption1M" Value="[CRAFT_OPTION_1_M]" After="LaunchConditions" Sequence="both" Condition="ALLUSERS = 1" /><Property Id="CRAFT_OPTION_1_U" Secure="yes"><RegistrySearch Id="CRAFT_OPTION_1_USearch" Root="HKCU" Key="Software\SSHCraft\Installer" Name="DesktopShortcut" Type="raw" />
    </Property><SetProperty Id="SAVEDDESKTOPSHORTCUT" Action="CraftLoadOption1U" Value="[CRAFT_OPTION_1_U]" After="CraftLoadOption1M" Sequence="both" Condition="ALLUSERS &lt;&gt; 1" /></Package>

  <Fragment>
    <?if $(var.HasCraftFontLicences) = 1 ?>
    <ComponentGroup Id="CraftFontLicences" Directory="INSTALLFOLDER">
      <Files Include="$(var.DocsDir)\**" />
    </ComponentGroup>
    <?endif?>
    <ComponentGroup Id="SshcraftFiles" Directory="INSTALLFOLDER">
      <Component Id="SshcraftApp" Guid="704F05C8-3FB1-4153-A58A-FC600F180CE8">
        <File Id="SshcraftExe" Source="$(var.BinDir)\sshcraft.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="SSHCraft" Description="SSHCraft SSH client" WorkingDirectory="INSTALLFOLDER" Advertise="yes" Icon="SshcraftIcon.ico" IconIndex="0" />
        </File>

        <RegistryValue Root="HKMU" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\sshcraft.exe" Value="[#SshcraftExe]" Type="string" />

        <!-- No file types: SSHCraft opens no documents. ssh:// links are offered to Windows as
             a capability, so the user picks SSHCraft in the default apps and no other program
             loses the link. A link only fills the quick connect dialog (docs/security.md). -->
        <RegistryValue Root="HKMU" Key="Software\Classes\SSHCraft.ssh" Value="URL:SSH link" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SSHCraft.ssh" Name="URL Protocol" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SSHCraft.ssh\DefaultIcon" Value="[#SshcraftExe],0" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SSHCraft.ssh\shell\open\command" Value="&quot;[#SshcraftExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\SSHCraft\Capabilities" Name="ApplicationName" Value="SSHCraft" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\SSHCraft\Capabilities" Name="ApplicationDescription" Value="SSH client with end-to-end encrypted sync" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\SSHCraft\Capabilities\URLAssociations" Name="ssh" Value="SSHCraft.ssh" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\RegisteredApplications" Name="SSHCraft" Value="Software\SSHCraft\Capabilities" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\SSHCraft" Name="InstallDir" Value="[INSTALLFOLDER]" Type="string" />
      </Component>

      <Component Id="SshcraftCli">
        <File Id="SshcraftCliExe" Source="$(var.BinDir)\sshcraft-cli.exe" KeyPath="yes" />
      </Component>

      <!-- sshcraft-cli on PATH, for agents (`sshcraft-cli mcp`) and
           scripts: the user's PATH for a per-user install, the system's for a per-machine one.
           Uninstalling takes the folder out again. -->
      <Component Id="CliPathUser" Condition="ALLUSERS &lt;&gt; 1">
        <Environment Id="PathUser" Name="PATH" Value="[INSTALLFOLDER]" Part="last" Action="set" System="no" Permanent="no" />
        <RegistryValue Root="HKMU" Key="Software\SSHCraft\Installer" Name="CliOnPath" Value="1" Type="integer" KeyPath="yes" />
      </Component>
      <Component Id="CliPathMachine" Condition="ALLUSERS = 1">
        <Environment Id="PathMachine" Name="PATH" Value="[INSTALLFOLDER]" Part="last" Action="set" System="yes" Permanent="no" />
        <RegistryValue Root="HKMU" Key="Software\SSHCraft\Installer" Name="CliOnPathMachine" Value="1" Type="integer" KeyPath="yes" />
      </Component>

      <!-- Persist both on and off, independently of the optional shortcut. AppSearch reads
           this before MajorUpgrade removes the previous product. -->
      <Component Id="DesktopShortcutPreference">
        <RegistryValue Root="HKMU" Key="Software\SSHCraft\Installer" Name="DesktopShortcut" Value="[DESKTOPSHORTCUT]" Type="string" KeyPath="yes" />
      </Component>
      <Component Id="DesktopShortcutComponent" Directory="DesktopFolder" Condition="DESKTOPSHORTCUT = &quot;1&quot;">
        <Shortcut Id="DesktopShortcut" Name="SSHCraft" Description="SSHCraft SSH client" Target="[#SshcraftExe]" WorkingDirectory="INSTALLFOLDER" Icon="SshcraftIcon.ico" IconIndex="0" />
        <!-- HKMU follows the chosen scope (HKLM for everyone, HKCU for one account), so the
             marker goes with the shortcut. MSI root -1 also satisfies ICE43 for this shortcut. -->
        <RegistryValue Root="HKMU" Key="Software\SSHCraft\Installer" Name="DesktopShortcutComponent" Value="1" Type="integer" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
